# Auto-detect text files and normalize line endings to LF on checkout/commit
* text=auto eol=lf

# Explicit LF for shell scripts, source code, configs, and documentation
*.sh text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.mako text eol=lf
*.css text eol=lf
Dockerfile* text eol=lf
.env* text eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.lock binary
