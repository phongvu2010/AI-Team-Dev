# ==============================================================================
# Database Configuration (PostgreSQL / Supabase)
# ==============================================================================

# Option A: Local PostgreSQL (Docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dev_db
# DIRECT_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dev_db

# Option B: Supabase (Hosted PostgreSQL)
# 1. DATABASE_URL: Dùng cho FastAPI App Runtime qua Supavisor Transaction Pooler (port 6543)
#    Lưu ý: Supavisor Transaction mode yêu cầu prepared_statement_cache_size=0
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?ssl=require&prepared_statement_cache_size=0
#
# 2. DIRECT_DATABASE_URL: BẮT BUỘC dùng cho Alembic Migrations qua Session Mode (port 5432)
#    Lý do: Alembic DDL và session-level locks không tương thích với Transaction Pooler port 6543
# DIRECT_DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?ssl=require

# In-memory database for isolated automated testing (Pytest)
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# Supabase Additional Config (Optional - for Auth/Storage/Realtime integration)
# SUPABASE_URL=https://[PROJECT_REF].supabase.co
# SUPABASE_ANON_KEY=eyJh...
# SUPABASE_SERVICE_ROLE_KEY=eyJh...

# ==============================================================================
# Backend Configuration (FastAPI)
# ==============================================================================
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production-1234567890
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:3001", "http://127.0.0.1:3001"]

# ==============================================================================
# Frontend Configuration (Next.js 15 / React 19)
# ==============================================================================
# Browser API endpoint (client-side):
NEXT_PUBLIC_API_URL=http://localhost:8000
# Internal Docker/SSR endpoint (server-side):
INTERNAL_API_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...

# Set to 'true' during Wave 1 (Frontend mock testing), set to 'false' for Wave 2 & Production (Live API)
# Lưu ý: Khi chuyển false, Next.js client cache sẽ tự động invalidate (cache: 'no-store')
NEXT_PUBLIC_USE_MOCKS=false

# ==============================================================================
# Model Allocation Matrix & Token Optimization (Google Antigravity 2.0 / Gemini)
# ==============================================================================
# Override toàn cục theo Tiers (Sẵn sàng cho thế hệ Gemini 3.8 Series):
# GEMINI_PRO_MODEL=gemini-2.5-pro        # Hoặc: gemini-3.8-pro
# GEMINI_FLASH_MODEL=gemini-2.5-flash    # Hoặc: gemini-3.8-flash
# GEMINI_FLASH_LITE_MODEL=gemini-2.5-flash-lite

# Override chi tiết theo từng Tác tử:
# BA_MODEL=gemini-2.5-flash
# PLANNER_MODEL=gemini-2.5-pro
# DB_DEV_MODEL=gemini-2.5-flash
# FRONTEND_DEV_MODEL=gemini-2.5-flash
# BACKEND_DEV_MODEL=gemini-2.5-pro
# QA_MODEL=gemini-2.5-flash
# CODE_REVIEW_MODEL=gemini-2.5-pro

# ==============================================================================
# Quality Gates & Verification Thresholds
# ==============================================================================
# Ngưỡng tối thiểu độ phủ mã nguồn Backend (Pytest-cov)
COV_FAIL_UNDER=80
# Bắt buộc thẩm định Zero Schema Drift với alembic check
STRICT_SCHEMA_DRIFT_CHECK=true
